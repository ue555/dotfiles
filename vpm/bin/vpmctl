#!/bin/sh

set -eu

VPM_BIN=${VPM_BIN:-vpm}
VPM_CONFIG=${VPM_CONFIG:-"$HOME/.config/vpm/plugins.json"}

usage() {
  cat <<'EOF'
Usage: vpmctl <command>

Commands:
  install   Install missing plugins
  update    Update installed plugins
  sync      Remove unused plugins, then install and update
  clean     Remove plugins absent from plugins.json
  list      List installed plugins
EOF
}

command_name=${1:-}
case "$command_name" in
  install|update|sync|clean|list)
    ;;
  help|-h|--help|"")
    usage
    exit 0
    ;;
  *)
    printf 'error: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

if ! command -v "$VPM_BIN" >/dev/null 2>&1; then
  printf 'error: vpm executable not found: %s\n' "$VPM_BIN" >&2
  exit 1
fi

if [ ! -f "$VPM_CONFIG" ]; then
  printf 'error: vpm configuration not found: %s\n' "$VPM_CONFIG" >&2
  exit 1
fi

exec "$VPM_BIN" -config "$VPM_CONFIG" -cmd "$command_name"
