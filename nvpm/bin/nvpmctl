#!/bin/sh

set -eu

NVPM_BIN=${NVPM_BIN:-nvpm}
NVPM_CONFIG=${NVPM_CONFIG:-"$HOME/.config/nvpm/plugins.json"}

usage() {
  cat <<'EOF'
Usage: nvpmctl <command> [plugin]

Commands:
  install   Install missing plugins
  update    Update installed plugins
  sync      Remove unused plugins, then install and update
  restore   Restore revisions from nvpm-lock.json
  clean     Remove plugins absent from plugins.json
  check     Check for updates
  list      List plugins
  stats     Show plugin statistics
EOF
}

command_name=${1:-}
case "$command_name" in
  install|update|sync|restore|clean|check|list|stats)
    ;;
  help|-h|--help|"")
    usage
    exit 0
    ;;
  *)
    printf 'error: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac

if ! command -v "$NVPM_BIN" >/dev/null 2>&1; then
  printf 'error: nvpm executable not found: %s\n' "$NVPM_BIN" >&2
  exit 1
fi

if [ ! -f "$NVPM_CONFIG" ]; then
  printf 'error: nvpm configuration not found: %s\n' "$NVPM_CONFIG" >&2
  exit 1
fi

shift
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

if [ "$#" -eq 1 ]; then
  exec "$NVPM_BIN" -config "$NVPM_CONFIG" -cmd "$command_name" -plugin "$1"
fi

exec "$NVPM_BIN" -config "$NVPM_CONFIG" -cmd "$command_name"
